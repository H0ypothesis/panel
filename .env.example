# Optional: real model providers. Demo works without credentials.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional: Exa API key. Search uses Exa MCP without a key by default.
EXA_API_KEY=
# Paperbypass gateway (Luna Pro + Atria-Dawn-Preview, Bearer auth).
PAPERBYPASS_API_KEY=
PAPERBYPASS_BASE_URL=https://aigateway.paperbypass.com/api
PAPERBYPASS_MODEL=openai/gpt-5.6-luna-pro
# Uncomment to select Luna Pro for new exploration roots.
# PANEL_DEFAULT_MODEL=paperbypass/openai/gpt-5.6-luna-pro
# To select Atria through Paperbypass for new exploration roots, use:
# PANEL_DEFAULT_MODEL=paperbypass/Atria-Dawn-Preview
# Atria (Anthropic Messages protocol, x-api-key auth).
ATRIA_API_KEY=
ATRIA_BASE_URL=https://api.atria-asi.ai
ATRIA_MODEL=Atria-Dawn-Preview
# To make Atria the default instead, use:
# PANEL_DEFAULT_MODEL=atria/Atria-Dawn-Preview
# Xiaomi MiMo Token Plan (China endpoint, subscription key).
XIAOMI_TOKEN_PLAN_CN_API_KEY=
XIAOMI_TOKEN_PLAN_CN_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
# Models: mimo-v2.6-pro, mimo-v2.6-flash, mimo-v2.5-pro.
# PANEL_DEFAULT_MODEL=xiaomi-token-plan-cn/mimo-v2.6-pro
# PORT=4317
# PANEL_DATA_DIR=.panel
